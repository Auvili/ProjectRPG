<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0.0.0 Safari/537.36 Edg/134.0.0.0" version="26.1.1">
  <diagram name="Page-1" id="VFXOi04C3vp5Mfpb2ym5">
    <mxGraphModel dx="1252" dy="692" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="9O7hutnVVW2RKfLPjpit-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="9O7hutnVVW2RKfLPjpit-5" target="9O7hutnVVW2RKfLPjpit-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9O7hutnVVW2RKfLPjpit-5" value="The island" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="200" y="150" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="9O7hutnVVW2RKfLPjpit-7" value="&lt;div style=&quot;text-wrap-mode: nowrap; line-height: 12px;&quot;&gt;&lt;font style=&quot;font-size: 5px; line-height: 5px;&quot;&gt;Same race as the people of the lands to the&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 5px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;north but culturally diff as they now see then self&#39;s as Isleman not Northman&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap; line-height: 12px;&quot;&gt;&lt;span style=&quot;font-size: 5px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;They have been cut of from the main content for over 200 years thanks to the boiling seas&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap; line-height: 12px;&quot;&gt;&lt;span style=&quot;font-size: 5px;&quot;&gt;place names and language have been corrupted over time reflecting the diverging culture&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap; line-height: 12px;&quot;&gt;&lt;span style=&quot;font-size: 5px;&quot;&gt;The land is split into 4 areas the western Somershore County (originally known as The county of Somershire)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap; line-height: 12px;&quot;&gt;&lt;span style=&quot;font-size: 5px;&quot;&gt;The Shattered lands running through the centre of the Island. These were caused by the same event the made the boiling seas&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap; line-height: 12px;&quot;&gt;&lt;span style=&quot;font-size: 5px;&quot;&gt;The Duchy of The Isle (originally known as the Duchy of Suisle) in the East .&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap; line-height: 12px;&quot;&gt;&lt;span style=&quot;font-size: 5px;&quot;&gt;In the past the duchy covered the hole island but after the shattered lands was formed travel&amp;nbsp; across the island dwindled&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap; line-height: 12px;&quot;&gt;&lt;span style=&quot;font-size: 5px;&quot;&gt;Finally there is The Fingers a stretch of coastland consisting of long thin spurs of land and bays. These are technically in the Duchy of the Isle&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap; line-height: 12px;&quot;&gt;&lt;span style=&quot;font-size: 5px;&quot;&gt;Birlbrook (village name)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap; line-height: 12px;&quot;&gt;&lt;span style=&quot;font-size: 5px;&quot;&gt;Vadenhell (town name originally Vaden Hall as town grow around a manor house)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="42.5" y="230" width="435" height="160" as="geometry" />
        </mxCell>
        <mxCell id="wec9Ze63oyw1QcqTsG4U-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="wec9Ze63oyw1QcqTsG4U-1" target="wec9Ze63oyw1QcqTsG4U-2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wec9Ze63oyw1QcqTsG4U-1" value="You" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="570" y="150" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wec9Ze63oyw1QcqTsG4U-2" value="Your a Messenger you get payed for delivering messages" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="570" y="230" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="-CBSohvA36bJALY2MObc-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="-CBSohvA36bJALY2MObc-1" target="-CBSohvA36bJALY2MObc-2">
